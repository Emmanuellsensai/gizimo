{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kola Companion character",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "roles", "personality", "languages", "voice"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["mentor", "friend", "pr", "companion", "accountability"] }
    },
    "personality": {
      "type": "object",
      "required": ["summary", "speechStyle"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "maxLength": 800 },
        "speechStyle": { "type": "string", "maxLength": 400 },
        "boundaries": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 12 }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["en", "pcm", "yo", "ig", "ha"] }
    },
    "voice": {
      "type": "object",
      "required": ["pack"],
      "additionalProperties": false,
      "properties": {
        "pack": { "type": "string", "description": "Voice pack id, or 'os' for system speech" },
        "gender": { "enum": ["female", "male"] },
        "speed": { "type": "number", "minimum": 0.6, "maximum": 1.5, "default": 1.0 },
        "premium": { "type": "boolean", "default": false, "description": "Use the paid Kola voice API (needs its own key)" }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "description": "Relative path to the uploaded photo in app data" },
        "consentConfirmed": { "type": "boolean" },
        "style": { "enum": ["photo-warp", "stylized", "cartoon", "vrm"], "default": "photo-warp" },
        "model": { "type": "string", "description": "File name of the 3D character (VRM) saved for this character" },
        "cartoon": { "type": "string", "description": "File name of the cartoon version of the photo" },
        "eyes": {
          "type": "array",
          "description": "The two eyes in the photo, as fractions of its width and height, for blinking",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["x", "y", "w"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "w": { "type": "number", "minimum": 0.02, "maximum": 0.3 }
            }
          }
        },
        "mouth": {
          "type": "object",
          "description": "Where the mouth is in the photo, as fractions of its width and height, and its width",
          "required": ["x", "y", "w"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "w": { "type": "number", "minimum": 0.05, "maximum": 0.6 }
          }
        }
      }
    },
    "proactive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkIns": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["time", "prompt"],
            "additionalProperties": false,
            "properties": {
              "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "prompt": { "type": "string", "maxLength": 300 }
            }
          }
        },
        "quietHours": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "to": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxTier": { "enum": [0, 1, 2, 3], "default": 1 },
        "allowApps": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
        "allowFolders": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "allowUrlHosts": { "type": "array", "items": { "type": "string" }, "maxItems": 50 }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "maxItems": { "type": "integer", "minimum": 50, "maximum": 5000, "default": 500 }
      }
    }
  }
}
